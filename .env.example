# ==============================================================================
# MediSum AI - Environment Configuration
# Copy this file to .env.local and populate your credentials
# ==============================================================================

# GROQ API (Free Tier at https://console.groq.com)
# Recommended models: llama-3.3-70b-versatile (EHR extractor) & llama-3.1-8b-instant (Fast clinical chat)
GROQ_API_KEY=gsk_your_groq_api_key_here

# SUPABASE CREDENTIALS (Optional - app will run with built-in database if omitted)
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here
